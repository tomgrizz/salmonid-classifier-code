# Normalise line endings so the repo is identical on Windows / Linux / macOS.
* text=auto eol=lf

# Scripts that must stay LF even on Windows checkouts
*.py   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.txt  text eol=lf
*.cff  text eol=lf
Makefile text eol=lf

# PowerShell runners are Windows-targeted -> CRLF
*.ps1  text eol=crlf

# Treat data as text (diff-able) but don't munge
*.csv  text eol=lf
*.json text eol=lf
*.patch -text
