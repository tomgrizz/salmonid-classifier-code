# --- regenerated outputs (safe to delete; `python run_tier1.py` recreates them) ---
# figures/ holds only generated artifacts; keep the dir, ignore its contents
figures/*
!figures/.gitkeep
output/
*.log

# --- large external artifacts (see docs/DATA_AVAILABILITY.md; never commit) ---
# model weights, the frozen training set, stored detections, raw footage
*.pth
*.pt
*.pkl
data/coco/
data/stores/
data/corpus/
# the multi-GB SAM2 cutout library (the two photo figures read from it)
data/sam2_cutouts/

# --- python ---
__pycache__/
*.pyc
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv_deim/
.venv_track/
.env

# --- editor / OS / assistant scratch ---
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/worktrees/
.claude/settings.local.json

# Tier-2 downloads placed inside the clone (the default location config.py looks in)
external/
